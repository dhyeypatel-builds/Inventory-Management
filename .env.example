# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# For local development (outside Docker): use localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tyrestock

# For running inside Docker Compose: use service name
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tyrestock

# Test database (used by Jest integration tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tyrestock_test

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=6183489357939b17df6dd5251192dadedd5d3f3a807d2da0dacbfc7dc802b381a79115b287d086c300d50d29cfa3df35359871a51e8c8197cbb306e1618ef9ad
JWT_REFRESH_SECRET=86d4d42eb07f59b24407f787fc82a1ad26725bd3942df570e24ba68afbb91af16c3ed92982af991598e0b500cada686c421c6433a560725f53209227b31a7dbc

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ─────────────────────────────────────────────────────────────────
# Max failed logins before account lockout
AUTH_MAX_FAILED_LOGINS=5

# ─── Seed / Admin ─────────────────────────────────────────────────────────────
# Tenant ADMIN user (seeded into the default tenant)
ADMIN_EMAIL=admin@tyrestock.app
ADMIN_PASSWORD=Admin@123!
ADMIN_FULL_NAME=System Admin

# ─── Platform Admin (master admin — Phase 2A/2B) ──────────────────────────────
# The master account that provisions/manages tenants. Lives outside all tenants.
PLATFORM_ADMIN_EMAIL=owner@tyrestock.app
PLATFORM_ADMIN_PASSWORD=Platform@123!
PLATFORM_ADMIN_FULL_NAME=Platform Owner

# ─── Phase 2C — public URL ────────────────────────────────────────────────────
# Used to build invite/login links in emails. Set to the deployed frontend URL.
# No domain yet? Use your server's IP: http://<hetzner-ip>:8080
APP_URL=http://localhost:3000

# ─── Phase 2C — transactional email (OTP + invites + welcome) ─────────────────
# EMAIL_TRANSPORT=dev writes rendered mail to backend/<EMAIL_DEV_DIR> and logs it
# (no provider account needed). Set =smtp to send real email.
EMAIL_TRANSPORT=dev
EMAIL_FROM="TyreStock <no-reply@tyrestock.app>"
EMAIL_DEV_DIR=tmp/emails
# SMTP — required when EMAIL_TRANSPORT=smtp. Works with any provider.
#   Gmail (app password): host smtp.gmail.com, port 587, secure false, user = your
#     gmail address, pass = the 16-char app password. EMAIL_FROM must be that gmail.
#   Resend/Postmark/SES: use the host/credentials from your provider dashboard.
#   For a custom domain, add SPF + DKIM + DMARC DNS or mail lands in spam.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dhyey.c.patel@gmail.com
SMTP_PASS=wpxp lbjy rxow xigc
SMTP_SECURE=false

# ─── Phase 2C — file storage (logo upload) ────────────────────────────────────
# STORAGE_TRANSPORT=local writes under backend/<STORAGE_LOCAL_DIR> (dev). s3 is
# wired later (needs bucket creds). UPLOAD_MAX_BYTES caps logo size.
STORAGE_TRANSPORT=local
STORAGE_LOCAL_DIR=uploads
UPLOAD_MAX_BYTES=2097152

# ─── Phase 2D — branded PDF rendering (headless Chrome) ───────────────────────
# Path to Chrome/Chromium for report PDFs. If unset, common paths are probed
# (/usr/bin/google-chrome, /usr/bin/chromium, …). The backend Docker image sets
# this to /usr/bin/chromium-browser.
# CHROME_PATH=/usr/bin/google-chrome

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1

# ─── Postgres (Docker Compose) ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tyrestock

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the frontend container is exposed on. Access the app at http://<server-ip>:FRONTEND_PORT
# FRONTEND_PORT=8080
